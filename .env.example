# procura-frontend — environment (EXAMPLE)
# Copy to `.env` and fill in. NEVER commit the real .env.
#
# IMPORTANT: every value here is PUBLIC. VITE_* variables are embedded into the
# browser bundle at build time. Never put a secret in this file.

# Backend REST API base URL
VITE_API_BASE_URL=http://localhost:8080

# Stellar network (labeling + guard): testnet | mainnet
VITE_STELLAR_NETWORK=testnet

# Network passphrase — used by the signing guard so a tx can't be signed for the
# wrong network.
VITE_STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Stellar RPC endpoint (submit / poll)
VITE_STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Deployed contract & payment token ids (public on-chain identifiers)
VITE_ESCROW_CONTRACT_ID=C...replace_me...
VITE_TOKEN_CONTRACT_ID=C...replace_me...

# Optional: WalletConnect project id (only if WalletConnect is enabled in the kit)
VITE_WALLETCONNECT_PROJECT_ID=
