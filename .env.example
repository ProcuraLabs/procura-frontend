# procura-frontend — environment (EXAMPLE)
# Copy to `.env` and fill in. NEVER commit the real .env.
#
# IMPORTANT: every value here is PUBLIC. VITE_* variables are embedded into the
# browser bundle at build time. Never put a secret (private key, secret key,
# API secret) in this file.
#
# In development these may be omitted — the app falls back to the localhost /
# testnet defaults below. In a production build the required values must be set
# or the app fails fast at startup with a clear error.

# Application environment label (optional; defaults to the Vite mode)
VITE_APP_ENV=development

# Backend REST API base URL (required in production)
VITE_API_BASE_URL=http://localhost:8080

# Stellar network: testnet | mainnet (required in production)
VITE_STELLAR_NETWORK=testnet

# Soroban RPC endpoint — submit / poll transactions (required in production)
VITE_STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Deployed Procura Soroban contract id (public on-chain identifier, required in production)
VITE_PROCURA_CONTRACT_ID=C...replace_me...
